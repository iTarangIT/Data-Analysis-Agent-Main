APP_ENV=dev
LOG_LEVEL=INFO

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase: the `analyst` and `checkpoints` schemas of the project's database, each with its own
# role whose search_path is that schema (scripts/bootstrap_supabase.sql). Session pooler, port
# 5432, because the direct db.<ref>.supabase.co host is IPv6 only; the user is <role>.<ref>.
APP_DB_URL=postgresql+psycopg://analyst_app.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
CHECKPOINT_DB_URL=postgresql://analyst_ckpt.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Or local native Postgres on 5432, which the test suite always uses (tests/conftest.py). The
# 5433/5434/5435 ports in the manual belong to docker-compose.dev.yml (CI and VPS only).
# APP_DB_URL=postgresql+psycopg://app:app@localhost:5432/analyst
# CHECKPOINT_DB_URL=postgresql://ckpt:ckpt@localhost:5432/checkpoints

# The database MCP server, which runs as its own process:
#   uvicorn app.database_mcp:app --port 8001
# Its secret is its own, so a stolen user session cannot be replayed against it.
DATABASE_MCP_URL=http://127.0.0.1:8001/mcp
MCP_JWT_SECRET=change-me-separately-32-chars-minimum

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Supabase Auth signs every user in. This service only verifies its access tokens, against the
# project's public keys at <SUPABASE_URL>/auth/v1/.well-known/jwks.json, so it holds no secret.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only scripts/supabase_token.py uses this, to sign in for the evals and check scripts.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Whether a signed-in Supabase user with no account here may create an organisation.
ALLOW_OPEN_SIGNUP=true

# Only reached when a browser calls this service directly. The Next.js app proxies
# server-side, so its requests carry no Origin. Comma-separated or a JSON list.
CORS_ORIGINS=http://localhost:3000

# How many of a connection's tables the agent may be given. Each one's structure is in every
# query prompt, so raising this grows that prompt.
MAX_AGENT_TABLES=12
MAX_ROWS=500
STATEMENT_TIMEOUT_MS=8000
MAX_SQL_RETRIES=2
# Total tool calls one question may make. Distinct from MAX_SQL_RETRIES, which counts only
# retries after a rejection.
MAX_TOOL_CALLS=6

# The agent's long-term memory: a glossary, the queries that answered earlier questions, and a
# record of each thread. "postgres" keeps it in the App DB beside the account it belongs to, in
# two tables LangGraph creates and Alembic is told to ignore. "memory" keeps it for the life of
# one process, which is enough for local work. "off" attaches no store at all.
MEMORY_BACKEND=postgres
# Old tool results are cleared before a thread is summarised, because clearing costs nothing and
# summarising costs a model call.
CLEAR_TOOL_RESULTS_AFTER_TOKENS=12000
SUMMARIZE_AFTER_TOKENS=24000
KEEP_MESSAGES=20

FILE_STORE_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
MAX_DATASET_BYTES=104857600
# Where a dataset's Parquet lives. "local" keeps it under FILE_STORE_DIR; "supabase" keeps it in a
# private Storage bucket and caches what runs read under FILE_STORE_DIR/cache. The secret key
# (sb_secret_...) is sent as the apikey header only.
FILE_STORE_BACKEND=local
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=datasets
# Every upload is parsed in a spawned process, killed after INGEST_TIMEOUT_S seconds. On Linux it is
# also held to INGEST_MEMORY_MB of address space; Windows has no such limit.
INGEST_TIMEOUT_S=90
INGEST_MEMORY_MB=2048
MAX_PDF_PAGES=150

# Memurai (native Windows Redis) on 6379. QUEUE_ENABLED=false runs the agent in-process and
# needs no Redis at all, which is the default and what the test suite uses.
# 127.0.0.1, not localhost: Memurai binds IPv4 only and localhost resolves to ::1 first.
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_ENABLED=false
RUN_TIMEOUT_S=180
RUN_HEARTBEAT_S=2.0
RUN_STALL_TIMEOUT_S=15.0
RUN_STREAM_TTL_S=900
# Each job holds an App DB session, a checkpoint connection, a store connection and a customer
# DB connection, against a pool of 5 plus 10 overflow.
WORKER_MAX_JOBS=3

MAX_RUNS_PER_MINUTE=10
MAX_CONCURRENT_RUNS=3

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=analyst-agent-dev
# Leave empty for a US account. An EU account needs https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=
