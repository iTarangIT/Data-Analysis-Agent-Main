APP_ENV=dev
LOG_LEVEL=INFO

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local native Postgres 16/17 on 5432 holds all three databases.
# The 5433/5434/5435 ports in the manual belong to docker-compose.dev.yml (CI and VPS only).
APP_DB_URL=postgresql+psycopg://app:app@localhost:5432/analyst
CHECKPOINT_DB_URL=postgresql://ckpt:ckpt@localhost:5432/checkpoints

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
# Shared with analyst-web, which mints the agent JWT. 32 characters minimum.
JWT_SECRET=change-me-32-chars-minimum

# 0 = never put customer rows in a model prompt. Required for the iTarang IoT source.
SCHEMA_SAMPLE_ROWS=3
MAX_ROWS=500
STATEMENT_TIMEOUT_MS=8000
MAX_SQL_RETRIES=2
# Total tool calls one question may make. Distinct from MAX_SQL_RETRIES, which counts only
# retries after a rejection.
MAX_TOOL_CALLS=6

SESSION_STORE_DIR=./sessions
FILE_STORE_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
PLAYWRIGHT_HEADLESS=true
WEB_DATA_URL_MATCH=/api/
WEB_NAV_TIMEOUT_MS=60000
WEB_DATA_TIMEOUT_MS=25000
WEB_SETTLE_MS=1500

# Test fixtures for the phase 3 live check, not settings. pytest does not read this file, so
# export them in the shell before running tests/integration/test_web_runs.py.
# INTELLICAR_URL=https://track.intellicar.in/u/0
# INTELLICAR_ID=
# INTELLICAR_PASSWORD=
# The dashboard calls several endpoints; this one carries the vehicle groups.
# INTELLICAR_DATA_MATCH=/api/group/listevgroups

# Memurai (native Windows Redis) on 6379. QUEUE_ENABLED=false runs the agent in-process and
# needs no Redis at all, which is the default and what the test suite uses.
REDIS_URL=redis://localhost:6379/0
QUEUE_ENABLED=false
RUN_TIMEOUT_S=180
RUN_HEARTBEAT_S=2.0
RUN_STALL_TIMEOUT_S=15.0
RUN_STREAM_TTL_S=900
WORKER_MAX_JOBS=4

MAX_RUNS_PER_MINUTE=10
MAX_CONCURRENT_RUNS=3

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=analyst-agent-dev
